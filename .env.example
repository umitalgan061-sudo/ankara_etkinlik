# Sunucu
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4000,http://localhost:4173
CACHE_TTL_SECONDS=300
SOURCE_TIMEOUT_MS=12000
CLIENT_RATE_LIMIT_PER_MINUTE=120

# WhatsMood: Dokümante edilen JSON etkinlik ucu anahtarsızdır.
# İstek sınırı: IP başına dakikada 60; kaynak URL'si ve atfı korunur.
WHATS_MOOD_ENABLED=true

# Etkinlik.io REST API: Yayıncı ağı onayı ve token gerekir.
ETKINLIKIO_API_TOKEN=
ETKINLIKIO_API_BASE_URL=https://etkinlik.io/api/v2

# Etkinlik.io RSS: RSS sayfasından Ankara şehri seçilerek oluşturulan
# kişiye/filtreye özel URL buraya yazılmalıdır. Genel RSS tüm şehirleri içerir.
ETKINLIKIO_RSS_URL=

# Biletsa: Okuma API anahtarı Biletsa'dan talep edilir.
BILETSA_API_KEY=
BILETSA_API_BASE_URL=https://biletsa.com/api/v1

# Ticketmaster Discovery API: Developer Portal'dan Consumer Key alınır.
TICKETMASTER_API_KEY=

# İsteğe bağlı, Ankara için hazırlanmış diğer RSS akışları.
# Örnek: [{"id":"cankaya","name":"Çankaya Belediyesi","url":"https://ornek.org/ankara.rss","city":"Ankara"}]
EXTRA_RSS_FEEDS=[]
